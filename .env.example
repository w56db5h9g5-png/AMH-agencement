# Copier dans .env localement ; ne pas versionner les valeurs réelles.
SITE_URL=https://amh-agencement.com
PORT=3000
AMH_DATA_DIR=instance
# Production HTTPS uniquement :
COOKIE_SECURE=0
# Garder 0 en préproduction ; activer après validation et publication.
INDEXING_ENABLED=0
# N'activer que derrière un reverse proxy maîtrisé, sans accès direct public :
TRUST_PROXY_COUNT=0
# Hash scrypt généré avec la commande du README. Aucun mot de passe par défaut.
ADMIN_PASSWORD_HASH=
# Facultatif si la clé persistante instance/session.key est conservée.
SECRET_KEY=
# STARTTLS (587) ou TLS implicite : SMTP_MODE=ssl, SMTP_PORT=465.
SMTP_HOST=
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO=contact@amh-agencement.com
